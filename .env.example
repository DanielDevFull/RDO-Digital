# ==========================================================
# RDO Digital - Variáveis de Ambiente
# Copie este arquivo para `.env` e ajuste os valores.
# ==========================================================

# Banco de dados PostgreSQL
DATABASE_URL="postgresql://rdo:rdo_secret@localhost:5432/rdo_digital?schema=public"

# Segredo para assinatura de tokens JWT (use um valor longo e aleatório)
JWT_SECRET="troque-por-um-segredo-bem-longo-e-aleatorio-com-mais-de-32-chars"

# Tempo de expiração do token de acesso
JWT_EXPIRES_IN="8h"

# URL pública usada na geração dos QR Codes dos estoques
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Diretório de uploads das fichas FISPQ (relativo a /public)
UPLOAD_DIR="public/uploads"

# Ambiente (development | production)
NODE_ENV="development"
